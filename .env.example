# Neon
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fashion-video-studio
R2_PUBLIC_BASE_URL=https://your-bucket.example.com

# Payment: manual_qr | stripe | both
PAYMENT_MODE=both

# Stripe (international cards) — webhook: https://YOUR_DOMAIN/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# usd (default, CNY÷FX) or cny
STRIPE_CURRENCY=usd

# Auth.js
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
# Local/admin bootstrap (creates admin user). Remove in production if unused.
AUTH_DEV_PASSWORD=

# WeChat Open Platform — website app
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
ADMIN_WECHAT_OPENIDS=

# Google OAuth (Auth.js) — redirect: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_GOOGLE_EMAILS=

# Personal pay QR image URLs
PAY_QR_WECHAT_URL=
PAY_QR_ALIPAY_URL=

# WeCom group robot (notify on claim)
WECOM_WEBHOOK_URL=

# Optional QQ email backup notify
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

# Epay (kept for future; unused in manual_qr mode)
EPAY_PID=
EPAY_KEY=
EPAY_API_URL=https://pay.example.com/submit.php
EPAY_NOTIFY_URL=https://your.app/api/webhooks/epay
EPAY_RETURN_URL=https://your.app/orders
EPAY_RATE=0.025

# Pricing
PRICE_FX_CNY_PER_USD=7.2
PRICE_GPU_USD_HR_24=0.69
PRICE_GPU_USD_HR_24_PRO=1.10
PRICE_GPU_USD_HR_48=1.22
PRICE_GPU_USD_HR_48_PRO=1.75
PRICE_MULTIPLIER=2
PRICE_MIN_CENTS_FLUX=50
PRICE_MIN_CENTS_LTX=990
PRICE_MIN_CENTS_LTX_48=1490
PRICE_LTX_COLD_OVERHEAD_SEC=420
PRICE_LTX_HOT_SEC=180

# RunPod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_IMAGE_24=
RUNPOD_ENDPOINT_VIDEO_24=
RUNPOD_ENDPOINT_VIDEO_48=
FLUX_CKPT_NAME=flux1-dev-fp8.safetensors

# DeepLX — must be set on Vercel too (Project → Settings → Environment Variables).
# Use the public DeepLX URL (https://….vercel.app), NOT localhost.
# If DeepLX fails, TRANSLATE_FALLBACK=true silently uses MyMemory — set false in prod to surface errors.
DEEPLX_API_URL=
DEEPLX_TOKEN=
TRANSLATE_PROVIDER=deeplx
TRANSLATE_FALLBACK=true
SAVE_OUTPUT_TO_R2=false
CRON_SECRET=change-me
APP_BASE_URL=http://localhost:3000
